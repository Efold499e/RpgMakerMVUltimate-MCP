# DeepSeek agent for RPG Maker MV — copy to .env and fill in.

# Required
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_API_URL=https://api.deepseek.com
# RPGMAKER_PROJECT_PATH=D:\path\to\your\rpgmaker\mv\project
# RPGMAKER_MCP_SERVER=D:\path\to\RpgMakerMVUltimate-MCP\dist\index.js
# RPGMAKER_SKILLS_DIR=D:\path\to\.claude\skills
# DEEPSEEK_MAX_STEPS=10
# DEEPSEEK_NO_TOOLS=0
# DEEPSEEK_THINKING=0
